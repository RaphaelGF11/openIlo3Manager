<?xml version="1.0" encoding="utf-8"?>
<!--
  The panel is a bitmap, because RemoteViews cannot draw. The caption underneath carries the host
  name and the time of the reading: a picture of LEDs says nothing about how old it is.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center">

        <ImageView
            android:id="@+id/panel"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:adjustViewBounds="true"
            android:scaleType="fitCenter"
            android:contentDescription="@string/widget_front_panel_description" />

        <TextView
            android:id="@+id/caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:paddingTop="4dp"
            android:maxLines="1"
            android:ellipsize="end"
            android:textSize="12sp"
            android:shadowColor="#000000"
            android:shadowRadius="3"
            android:textColor="#E6FFFFFF" />
    </LinearLayout>

    <!-- Kept clear of the panel's own tap target, which opens the server it belongs to. -->
    <ImageView
        android:id="@+id/refresh"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:layout_gravity="top|end"
        android:padding="6dp"
        android:src="@drawable/ic_widget_refresh"
        android:contentDescription="@string/widget_front_panel_refresh" />
</FrameLayout>
