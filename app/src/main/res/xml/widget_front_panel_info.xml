<?xml version="1.0" encoding="utf-8"?>
<!--
  updatePeriodMillis is left at 0 on purpose: the framework's own period is capped at 30 minutes and
  ignores network conditions, so the refresh is driven by WorkManager instead (see FrontPanelWidget).
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="250dp"
    android:minHeight="180dp"
    android:targetCellWidth="4"
    android:targetCellHeight="3"
    android:updatePeriodMillis="0"
    android:initialLayout="@layout/widget_front_panel"
    android:configure="net.raphaelgf11.ilo3manager.widget.FrontPanelConfigActivity"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen"
    android:description="@string/widget_front_panel_description" />
